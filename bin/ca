#!/usr/bin/env bash
set -Eeuo pipefail

APP_NAME="ca"
APP_TITLE="CA - Caddy 管理工具"
CONFIG_DIR="/etc/ca-manager"
RULES_DIR="$CONFIG_DIR/rules.d"
CONFIG_FILE="$CONFIG_DIR/config.env"
CADDYFILE="/etc/caddy/Caddyfile"
CF_ENV_FILE="/etc/caddy/secrets/cloudflare.env"
CF_SECRETS_DIR="$(dirname "$CF_ENV_FILE")"
SYSTEMD_DROPIN_DIR="/etc/systemd/system/caddy.service.d"
SYSTEMD_DROPIN="$SYSTEMD_DROPIN_DIR/10-cloudflare-env.conf"
CA_UPDATE_URL="${CA_UPDATE_URL:-https://api.github.com/repos/shenxianmq/vps-helper/contents/bin/ca?ref=main}"
CADDY_RELEASE_TAG="${CADDY_RELEASE_TAG:-v0.1.0-caddy-2.11.3}"
CADDY_RELEASE_BASE="${CADDY_RELEASE_BASE:-https://github.com/shenxianmq/vps-helper/releases/download/$CADDY_RELEASE_TAG}"

die() {
  echo "错误：$*" >&2
  exit 1
}

need_root() {
  if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
    die "请使用 root 运行，例如：sudo ca"
  fi
}

log() {
  printf '[%s] %s\n' "$APP_NAME" "$*"
}

UI_WIDTH="${CA_UI_WIDTH:-78}"
C_RESET=""
C_DIM=""
C_BOLD=""
C_CYAN=""
C_GREEN=""
C_YELLOW=""
C_RED=""

color_setup() {
  if [[ -t 1 && -z "${NO_COLOR:-}" ]] && command -v tput >/dev/null 2>&1; then
    C_RESET="$(tput sgr0 2>/dev/null || true)"
    C_DIM="$(tput dim 2>/dev/null || true)"
    C_BOLD="$(tput bold 2>/dev/null || true)"
    C_CYAN="$(tput setaf 6 2>/dev/null || true)"
    C_GREEN="$(tput setaf 2 2>/dev/null || true)"
    C_YELLOW="$(tput setaf 3 2>/dev/null || true)"
    C_RED="$(tput setaf 1 2>/dev/null || true)"
  fi
}

ui_repeat() {
  local char="$1"
  local count="${2:-$UI_WIDTH}"
  printf '%*s' "$count" '' | tr ' ' "$char"
}

ui_border() {
  local char="${1:-=}"
  printf '%s+%s+%s\n' "$C_CYAN" "$(ui_repeat "$char")" "$C_RESET"
}

ui_rule() {
  printf '%s%s%s\n' "$C_CYAN" "$(ui_repeat '-')" "$C_RESET"
}

ui_title() {
  local title="$1"
  ui_border "="
  printf '%s#  %s%s%s\n' "$C_CYAN" "$C_BOLD" "$title" "$C_RESET"
  ui_border "="
}

ui_section() {
  local title="$1"
  echo
  printf '%s%s%s\n' "$C_CYAN" "$(ui_repeat '-')" "$C_RESET"
  printf '%s%s%s\n' "$C_BOLD" "$title" "$C_RESET"
}

ui_menu_row() {
  local left_no="$1"
  local left_label="$2"
  local right_no="${3:-}"
  local right_label="${4:-}"
  if [[ -n "$right_no" ]]; then
    printf '%s%2s.%s %-32s  %s%2s.%s %s\n' \
      "$C_CYAN" "$left_no" "$C_RESET" "$left_label" \
      "$C_CYAN" "$right_no" "$C_RESET" "$right_label"
  else
    printf '%s%2s.%s %s\n' "$C_CYAN" "$left_no" "$C_RESET" "$left_label"
  fi
}

ui_prompt() {
  printf '%s->%s 请输入选项：' "$C_CYAN" "$C_RESET"
}

usage() {
  cat <<'EOF'
ca - Caddy 简易反向代理管理工具

用法：
  ca install                         安装/启用 Caddy，并安装 Cloudflare DNS 插件
  ca bootstrap                        一条龙安装：校验并应用当前规则
  ca token set DOMAIN [TOKEN]          设置某个域名的 Cloudflare API token
  ca token check [DOMAIN]              检查 token 文件或某个域名的 token 是否存在
  ca apply                           生成 Caddyfile、校验并重载 Caddy
  ca show                            查看规则和当前 Caddyfile
  ca caddyfile                       一键查看当前真实 Caddyfile
  ca status                          查看 Caddy 状态、监听端口和模块
  ca test [host ...]                 测试已配置或指定的域名
  ca logs [N]                        查看最近的 Caddy 日志，默认 80 行
  ca update                          从 GitHub 检查并更新 ca 自身
  ca add-wildcard DOMAIN UPSTREAM    添加泛域名规则：*.DOMAIN 和 DOMAIN -> UPSTREAM
  ca add-fixed DOMAIN UPSTREAM       添加固定域名规则：DOMAIN -> UPSTREAM
  ca remove DOMAIN                   删除指定域名的规则
  ca list                            列出规则文件

示例：
  ca bootstrap
  ca token set DOMAIN
  ca add-wildcard DOMAIN UPSTREAM
  ca add-fixed DOMAIN UPSTREAM
  ca apply
EOF
}

load_config() {
  EMAIL=""
  mkdir -p "$CONFIG_DIR" "$RULES_DIR"
  if [[ -f "$CONFIG_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
  fi
}

ensure_default_config() {
  mkdir -p "$CONFIG_DIR" "$RULES_DIR"
  if [[ ! -f "$CONFIG_FILE" ]]; then
    cat >"$CONFIG_FILE" <<EOF
EMAIL=""
EOF
    chmod 0644 "$CONFIG_FILE"
  fi

}

ensure_email_config() {
  load_config
  if [[ -n "$EMAIL" ]]; then
    return 0
  fi

  read -rp "请输入 ACME 证书通知邮箱：" EMAIL
  [[ -n "$EMAIL" ]] || die "邮箱不能为空"
  cat >"$CONFIG_FILE" <<EOF
EMAIL="$EMAIL"
EOF
  chmod 0644 "$CONFIG_FILE"
}

sanitize_domain() {
  local domain="$1"
  [[ "$domain" =~ ^[A-Za-z0-9.*_-]+$ ]] || die "域名不合法：$domain"
  printf '%s' "$domain" | tr '[:upper:]' '[:lower:]'
}

validate_upstream() {
  local upstream="$1"
  [[ "$upstream" =~ ^https?://[^[:space:]]+$ || "$upstream" =~ ^[A-Za-z0-9._:-]+$ ]] || die "上游地址不合法：$upstream"
}

caddy_has_cloudflare() {
  command -v caddy >/dev/null 2>&1 && caddy list-modules 2>/dev/null | grep -qx 'dns.providers.cloudflare'
}

detect_linux_arch() {
  case "$(uname -m)" in
    x86_64|amd64) echo "amd64" ;;
    aarch64|arm64) echo "arm64" ;;
    *) return 1 ;;
  esac
}

install_caddy_from_release() {
  need_root
  command -v curl >/dev/null 2>&1 || return 1
  command -v tar >/dev/null 2>&1 || return 1
  command -v sha256sum >/dev/null 2>&1 || return 1

  local arch asset tmp archive sums expected actual backup
  arch="$(detect_linux_arch)" || return 1
  asset="caddy-linux-$arch.tar.gz"
  tmp="$(mktemp -d)"
  archive="$tmp/$asset"
  sums="$tmp/SHA256SUMS"

  log "尝试从 GitHub Release 下载 Caddy ($arch)"
  curl -fL "$CADDY_RELEASE_BASE/$asset" -o "$archive" || return 1
  curl -fL "$CADDY_RELEASE_BASE/SHA256SUMS" -o "$sums" || return 1

  expected="$(awk -v f="$asset" '$2 == "dist/" f {print $1}' "$sums")"
  [[ -n "$expected" ]] || return 1
  actual="$(sha256sum "$archive" | awk '{print $1}')"
  [[ "$expected" == "$actual" ]] || die "Caddy 下载包校验失败"

  tar -xzf "$archive" -C "$tmp"
  chmod 0755 "$tmp/caddy-linux-$arch"
  "$tmp/caddy-linux-$arch" list-modules | grep -qx 'dns.providers.cloudflare' || return 1

  if [[ -f /usr/bin/caddy ]]; then
    backup="/usr/bin/caddy.before-ca-release.$(date +%Y%m%d%H%M%S)"
    cp /usr/bin/caddy "$backup"
    log "已备份旧 Caddy：$backup"
  fi
  install -m 0755 "$tmp/caddy-linux-$arch" /usr/bin/caddy
  rm -rf "$tmp"
  log "已安装 Release 版 Caddy：/usr/bin/caddy"
}

install_caddy() {
  need_root
  if caddy_has_cloudflare; then
    log "Caddy 已安装且包含 Cloudflare DNS 插件"
  else
    if install_caddy_from_release; then
      log "Caddy Release 二进制安装完成"
    else
      install_caddy_from_apt
    fi
  fi

  mkdir -p "$CF_SECRETS_DIR" "$SYSTEMD_DROPIN_DIR"
  chown root:caddy "$CF_SECRETS_DIR" 2>/dev/null || chown root:root "$CF_SECRETS_DIR"
  chmod 0750 "$CF_SECRETS_DIR"

  cat >"$SYSTEMD_DROPIN" <<EOF
[Service]
EnvironmentFile=$CF_ENV_FILE
EOF
  systemctl daemon-reload
  systemctl enable caddy
  log "安装完成"
}

install_caddy_from_apt() {
  log "正在安装 Caddy 官方源和软件包"
  apt-get update
  apt-get install -y debian-keyring debian-archive-keyring apt-transport-https curl gnupg

  if [[ ! -f /usr/share/keyrings/caddy-stable-archive-keyring.gpg ]]; then
    curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' \
      | gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg
  fi

  if [[ ! -f /etc/apt/sources.list.d/caddy-stable.list ]]; then
    curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' \
      | tee /etc/apt/sources.list.d/caddy-stable.list >/dev/null
  fi

  apt-get update
  apt-get install -y caddy

  if ! caddy list-modules 2>/dev/null | grep -qx 'dns.providers.cloudflare'; then
    log "正在给 Caddy 安装 Cloudflare DNS 插件"
    caddy add-package github.com/caddy-dns/cloudflare --keep-backup
  else
    log "Cloudflare DNS 插件已存在"
  fi
}

save_token() {
  need_root
  local domain="${1:-}"
  local token="${2:-}"
  [[ -n "$domain" ]] || die "请指定域名：ca token set DOMAIN"
  domain="$(sanitize_domain "$domain")"
  if [[ -z "$token" ]]; then
    read -rsp "请输入 $domain 的 Cloudflare API token：" token
    echo
  fi
  [[ -n "$token" ]] || die "token 不能为空"

  local token_env
  token_env="$(token_env_for_domain "$domain")"
  write_token_var "$token_env" "$token"
  log "$domain 的 token 已保存为变量 $token_env"
}

ensure_secret_store() {
  mkdir -p "$CF_SECRETS_DIR" "$SYSTEMD_DROPIN_DIR"
  touch "$CF_ENV_FILE"
  chown root:caddy "$CF_ENV_FILE" 2>/dev/null || chown root:root "$CF_ENV_FILE"
  chmod 0640 "$CF_ENV_FILE"

  cat >"$SYSTEMD_DROPIN" <<EOF
[Service]
EnvironmentFile=$CF_ENV_FILE
EOF
  systemctl daemon-reload
}

token_env_for_domain() {
  local domain="$1"
  domain="$(sanitize_domain "$domain")"
  printf 'CF_TOKEN_%s' "$(printf '%s' "$domain" | tr '[:lower:]' '[:upper:]' | sed -E 's/[^A-Z0-9]/_/g')"
}

secret_var_exists() {
  local name="$1"
  [[ -f "$CF_ENV_FILE" ]] && grep -qE "^${name}=" "$CF_ENV_FILE"
}

secret_var_value() {
  local name="$1"
  [[ -f "$CF_ENV_FILE" ]] || return 1
  grep -E "^${name}=" "$CF_ENV_FILE" | tail -n 1 | sed -E "s/^${name}=//"
}

write_token_var() {
  local name="$1"
  local value="$2"
  ensure_secret_store
  local tmp
  tmp="$(mktemp)"
  grep -vE "^${name}=" "$CF_ENV_FILE" >"$tmp" || true
  printf '%s=%s\n' "$name" "$value" >>"$tmp"
  install -m 0640 "$tmp" "$CF_ENV_FILE"
  chown root:caddy "$CF_ENV_FILE" 2>/dev/null || chown root:root "$CF_ENV_FILE"
  rm -f "$tmp"
}

ensure_rule_token_env() {
  local domain="$1"
  local token_env="${2:-}"
  domain="$(sanitize_domain "$domain")"
  [[ -n "$token_env" ]] || token_env="$(token_env_for_domain "$domain")"
  printf '%s' "$token_env"
}

ensure_token_secret_for_domain() {
  local domain="$1"
  local token_env="${2:-}"
  local token=""
  domain="$(sanitize_domain "$domain")"
  token_env="$(ensure_rule_token_env "$domain" "$token_env")"

  ensure_secret_store
  if secret_var_exists "$token_env"; then
    printf '%s' "$token_env"
    return 0
  fi

  if secret_var_exists "CLOUDFLARE_API_TOKEN"; then
    token="$(secret_var_value "CLOUDFLARE_API_TOKEN")"
    write_token_var "$token_env" "$token"
    printf '[%s] 已将旧全局 token 迁移为 %s 的变量 %s\n' "$APP_NAME" "$domain" "$token_env" >&2
    printf '%s' "$token_env"
    return 0
  fi

  if [[ -t 0 ]]; then
    read -rsp "请输入 $domain 的 Cloudflare API token：" token
    echo
    [[ -n "$token" ]] || die "$domain 的 token 不能为空"
    write_token_var "$token_env" "$token"
    printf '%s' "$token_env"
    return 0
  fi

  die "缺少 $domain 的 Cloudflare token，请先运行：ca token set $domain"
}


ensure_wildcard_token_secrets() {
  ensure_default_config
  local file domain upstream insecure token_env
  shopt -s nullglob
  for file in "$RULES_DIR"/*.wildcard; do
    DOMAIN="" UPSTREAM="" INSECURE_SKIP_VERIFY="1" TOKEN_ENV=""
    # shellcheck disable=SC1090
    source "$file"
    domain="$(sanitize_domain "$DOMAIN")"
    upstream="$UPSTREAM"
    insecure="$INSECURE_SKIP_VERIFY"
    token_env="$(ensure_rule_token_env "$domain" "$TOKEN_ENV")"
    ensure_token_secret_for_domain "$domain" "$token_env" >/dev/null
    if [[ "${TOKEN_ENV:-}" != "$token_env" ]]; then
      cat >"$file" <<EOF
DOMAIN="$domain"
UPSTREAM="$upstream"
INSECURE_SKIP_VERIFY="$insecure"
TOKEN_ENV="$token_env"
EOF
    fi
  done
}

check_token() {
  local domain="${1:-}"
  if [[ -z "$domain" ]]; then
    [[ -s "$CF_ENV_FILE" ]] && echo "token 文件存在：$CF_ENV_FILE" || die "token 文件不存在：$CF_ENV_FILE"
    return 0
  fi

  domain="$(sanitize_domain "$domain")"
  local token_env
  token_env="$(token_env_for_domain "$domain")"
  if secret_var_exists "$token_env"; then
    echo "$domain 的 token 存在：$token_env"
  else
    die "$domain 的 token 不存在：$token_env"
  fi
}

source_token_for_caddy() {
  [[ -s "$CF_ENV_FILE" ]] || return 0
  set -a
  # shellcheck disable=SC1090
  source "$CF_ENV_FILE"
  set +a
}

add_wildcard() {
  need_root
  local domain upstream file token_env
  domain="$(sanitize_domain "$1")"
  upstream="$2"
  token_env="${3:-}"
  validate_upstream "$upstream"
  token_env="$(ensure_token_secret_for_domain "$domain" "$token_env")"
  mkdir -p "$RULES_DIR"
  file="$RULES_DIR/$domain.wildcard"
  cat >"$file" <<EOF
DOMAIN="$domain"
UPSTREAM="$upstream"
INSECURE_SKIP_VERIFY="1"
TOKEN_ENV="$token_env"
EOF
  log "已添加泛域名规则：*.$domain, $domain -> $upstream，token 变量：$token_env"
}

add_fixed() {
  need_root
  local domain upstream file insecure
  domain="$(sanitize_domain "$1")"
  upstream="$2"
  validate_upstream "$upstream"
  insecure="0"
  if [[ "$upstream" =~ ^https://127\.0\.0\.1 || "$upstream" =~ ^https://localhost ]]; then
    insecure="1"
  fi
  mkdir -p "$RULES_DIR"
  file="$RULES_DIR/$domain.fixed"
  cat >"$file" <<EOF
DOMAIN="$domain"
UPSTREAM="$upstream"
INSECURE_SKIP_VERIFY="$insecure"
EOF
  log "已添加固定域名规则：$domain -> $upstream"
}

remove_rule() {
  need_root
  local domain
  domain="$(sanitize_domain "$1")"
  rm -f "$RULES_DIR/$domain.wildcard" "$RULES_DIR/$domain.fixed"
  log "已删除 $domain 对应的规则文件"
}

emit_reverse_proxy() {
  local upstream="$1"
  local insecure="${2:-0}"

  cat <<EOF
	reverse_proxy $upstream {
		header_up Host {host}
EOF
  if [[ "$upstream" =~ ^https:// && "$insecure" == "1" ]]; then
    cat <<'EOF'
		transport http {
			tls_insecure_skip_verify
		}
EOF
  fi
  cat <<'EOF'
	}
EOF
}

generate_caddyfile() {
  ensure_email_config
  cat <<EOF
{
	email $EMAIL
}

EOF

  local file domain upstream insecure token_env
  shopt -s nullglob
  for file in "$RULES_DIR"/*.wildcard; do
    DOMAIN="" UPSTREAM="" INSECURE_SKIP_VERIFY="1" TOKEN_ENV=""
    # shellcheck disable=SC1090
    source "$file"
    domain="$(sanitize_domain "$DOMAIN")"
    upstream="$UPSTREAM"
    insecure="$INSECURE_SKIP_VERIFY"
    token_env="$(ensure_rule_token_env "$domain" "$TOKEN_ENV")"
    validate_upstream "$upstream"
    cat <<EOF
*.$domain, $domain {
	tls {
		dns cloudflare {\$$token_env}
	}

EOF
    emit_reverse_proxy "$upstream" "$insecure"
    printf '}\n\n'
  done

  for file in "$RULES_DIR"/*.fixed; do
    DOMAIN="" UPSTREAM="" INSECURE_SKIP_VERIFY="0"
    # shellcheck disable=SC1090
    source "$file"
    domain="$(sanitize_domain "$DOMAIN")"
    upstream="$UPSTREAM"
    insecure="$INSECURE_SKIP_VERIFY"
    validate_upstream "$upstream"
    cat <<EOF
$domain {
EOF
    emit_reverse_proxy "$upstream" "$insecure"
    printf '}\n\n'
  done

  cat <<'EOF'
http:// {
	abort
}
EOF
}

apply_config() {
  need_root
  ensure_default_config
  local backup tmp
  tmp="$(mktemp)"
  generate_caddyfile >"$tmp"

  ensure_wildcard_token_secrets
  source_token_for_caddy
  caddy fmt --overwrite "$tmp"
  caddy validate --config "$tmp" --adapter caddyfile

  if [[ -f "$CADDYFILE" ]]; then
    backup="$CADDYFILE.before-ca.$(date +%Y%m%d%H%M%S)"
    cp "$CADDYFILE" "$backup"
    log "已备份当前 Caddyfile：$backup"
  fi

  install -m 0644 "$tmp" "$CADDYFILE"
  rm -f "$tmp"
  systemctl reload caddy || systemctl restart caddy
  log "Caddy 已重载"
}

show_rules() {
  ensure_default_config
  echo "== 规则文件 =="
  find "$RULES_DIR" -maxdepth 1 -type f | sort | while read -r file; do
    echo "-- $file"
    sed -E 's/(TOKEN|SECRET|KEY|PASSWORD)=.*/\1=***hidden***/' "$file"
  done
  echo
  echo "== 将要生成的 Caddyfile =="
  generate_caddyfile
  echo
  echo "== 当前生效的 Caddyfile =="
  [[ -f "$CADDYFILE" ]] && nl -ba "$CADDYFILE" || echo "$CADDYFILE 不存在"
}

show_caddyfile() {
  echo "== 当前真实 Caddyfile =="
  echo "路径：$CADDYFILE"
  echo
  if [[ ! -f "$CADDYFILE" ]]; then
    echo "$CADDYFILE 不存在"
    return 1
  fi

  nl -ba "$CADDYFILE"
}

status() {
  echo "== Caddy 信息 =="
  command -v caddy || true
  caddy version 2>/dev/null || true
  echo
  echo "== 已加载模块 =="
  caddy list-modules 2>/dev/null | grep -E '^(dns.providers.cloudflare|http.handlers.reverse_proxy)$' || true
  echo
  echo "== 服务状态 =="
  systemctl --no-pager --full status caddy | sed -n '1,18p' || true
  echo
  echo "== 监听端口 =="
  ss -ltnp | grep -E ':(80|443|8080|8443)\b' || true
}

test_hosts() {
  ensure_default_config
  local hosts=("$@")
  if [[ "${#hosts[@]}" -eq 0 ]]; then
    hosts=()
    local file domain
    shopt -s nullglob
    for file in "$RULES_DIR"/*.wildcard "$RULES_DIR"/*.fixed; do
      DOMAIN=""
      # shellcheck disable=SC1090
      source "$file"
      domain="$(sanitize_domain "$DOMAIN")"
      if [[ "$file" == *.wildcard ]]; then
        hosts+=("lucky.$domain" "random-check.$domain" "$domain")
      else
        hosts+=("$domain")
      fi
    done
  fi

  local host
  for host in "${hosts[@]}"; do
    echo "-- https://$host/ --"
    curl -skI --max-time 12 "https://$host/" | sed -n '1,10p' || true
    echo
  done
}

logs() {
  local lines="${1:-80}"
  journalctl -u caddy -n "$lines" --no-pager
}

ca_version_info() {
  local self
  self="$(readlink -f "${BASH_SOURCE[0]}")"
  echo "当前脚本：$self"
  echo "更新地址：$CA_UPDATE_URL"
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$self" | awk '{print "当前 SHA256：" $1}'
  fi
}

validate_ca_update_file() {
  local file="$1"
  bash -n "$file"

  local token_pattern private_begin_pattern private_key_pattern
  token_pattern='CLOUDFLARE_API_TOKEN=[A-Za-z0-9_./:+-]{20,}'
  private_begin_pattern='BEGIN ''(RSA |EC |OPENSSH |PRIVATE)'
  private_key_pattern='PRIVATE KEY''-----'
  for pattern in "$token_pattern" "$private_begin_pattern" "$private_key_pattern"; do
    if grep -nE "$pattern" "$file" >/dev/null; then
      die "下载内容命中敏感关键字，已取消更新"
    fi
  done
}

prepare_ca_update() {
  command -v curl >/dev/null 2>&1 || die "需要先安装 curl"

  local self tmp current_hash new_hash
  self="$(readlink -f "${BASH_SOURCE[0]}")"
  tmp="$(mktemp)"

  log "正在下载最新版 ca"
  curl -fsSL -H "Accept: application/vnd.github.raw" "$CA_UPDATE_URL" -o "$tmp"
  validate_ca_update_file "$tmp"

  current_hash="$(sha256sum "$self" | awk '{print $1}')"
  new_hash="$(sha256sum "$tmp" | awk '{print $1}')"

  CA_UPDATE_SELF="$self"
  CA_UPDATE_TMP="$tmp"
  CA_UPDATE_CURRENT_HASH="$current_hash"
  CA_UPDATE_NEW_HASH="$new_hash"

  echo "当前 SHA256：$current_hash"
  echo "远端 SHA256：$new_hash"
  if [[ "$current_hash" == "$new_hash" ]]; then
    echo "状态：已经是最新版。"
    return 1
  fi

  echo "状态：远端版本与当前不同，可以更新到远端版本。"
  return 0
}

cleanup_prepared_ca_update() {
  [[ -n "${CA_UPDATE_TMP:-}" ]] && rm -f "$CA_UPDATE_TMP"
  CA_UPDATE_TMP=""
}

install_prepared_ca_update() {
  local backup
  [[ -n "${CA_UPDATE_SELF:-}" && -n "${CA_UPDATE_TMP:-}" ]] || die "没有可安装的 ca 更新包"

  backup="$CA_UPDATE_SELF.before-update.$(date +%Y%m%d%H%M%S)"
  cp "$CA_UPDATE_SELF" "$backup"
  install -m 0755 "$CA_UPDATE_TMP" "$CA_UPDATE_SELF"
  cleanup_prepared_ca_update
  echo "已更新 ca。"
  echo "旧版本备份：$backup"
}

update_ca() {
  need_root
  if ! prepare_ca_update; then
    cleanup_prepared_ca_update
    return 0
  fi

  install_prepared_ca_update
}

interactive_update_ca() {
  need_root
  ca_version_info
  echo
  if ! confirm "现在检查远端版本吗？"; then
    return 0
  fi

  echo
  if ! prepare_ca_update; then
    cleanup_prepared_ca_update
    return 0
  fi

  echo
  if confirm "确认安装这个新版本吗？"; then
    install_prepared_ca_update
  else
    cleanup_prepared_ca_update
    echo "已取消更新。"
  fi
}

pause() {
  echo
  read -rp "按回车继续..." _
}

prompt_default() {
  local prompt="$1"
  local default="${2:-}"
  local value
  if [[ -n "$default" ]]; then
    read -rp "$prompt [$default]：" value
    printf '%s' "${value:-$default}"
  else
    read -rp "$prompt：" value
    printf '%s' "$value"
  fi
}

confirm() {
  local prompt="$1"
  local answer
  read -rp "$prompt [y/N]：" answer
  [[ "$answer" =~ ^[Yy]$|^[Yy][Ee][Ss]$ ]]
}

RULE_FILES=()
RULE_TYPES=()
RULE_DOMAINS=()
RULE_UPSTREAMS=()
RULE_TOKEN_ENVS=()

load_rules() {
  ensure_default_config
  RULE_FILES=()
  RULE_TYPES=()
  RULE_DOMAINS=()
  RULE_UPSTREAMS=()
  RULE_TOKEN_ENVS=()

  local file domain upstream token_env
  shopt -s nullglob
  for file in "$RULES_DIR"/*.wildcard "$RULES_DIR"/*.fixed; do
    DOMAIN="" UPSTREAM="" TOKEN_ENV=""
    # shellcheck disable=SC1090
    source "$file"
    domain="$(sanitize_domain "$DOMAIN")"
    upstream="$UPSTREAM"
    RULE_FILES+=("$file")
    RULE_DOMAINS+=("$domain")
    RULE_UPSTREAMS+=("$upstream")
    if [[ "$file" == *.wildcard ]]; then
      RULE_TYPES+=("wildcard")
      token_env="${TOKEN_ENV:-$(token_env_for_domain "$domain")}"
      RULE_TOKEN_ENVS+=("$token_env")
    else
      RULE_TYPES+=("fixed")
      RULE_TOKEN_ENVS+=("")
    fi
  done
}

rule_label() {
  local index="$1"
  local type="${RULE_TYPES[$index]}"
  local domain="${RULE_DOMAINS[$index]}"
  local upstream="${RULE_UPSTREAMS[$index]}"
  if [[ "$type" == "wildcard" ]]; then
    printf '[泛域名] *.%s, %s -> %s，token 变量：%s' "$domain" "$domain" "$upstream" "${RULE_TOKEN_ENVS[$index]}"
  else
    printf '[固定域名] %s -> %s' "$domain" "$upstream"
  fi
}

print_rules_numbered() {
  load_rules
  echo "当前规则："
  if [[ "${#RULE_FILES[@]}" -eq 0 ]]; then
    echo "  暂无规则。"
    return 0
  fi

  local i
  for i in "${!RULE_FILES[@]}"; do
    printf '  %d) %s\n' "$((i + 1))" "$(rule_label "$i")"
  done
}

resolve_rule_input() {
  local input="$1"
  local i
  [[ -n "$input" ]] || return 1

  if [[ "$input" =~ ^[0-9]+$ ]]; then
    i=$((input - 1))
    if (( i >= 0 && i < ${#RULE_FILES[@]} )); then
      printf '%s' "$i"
      return 0
    fi
  fi

  input="$(sanitize_domain "$input")"
  input="${input#*.}"
  for i in "${!RULE_FILES[@]}"; do
    if [[ "${RULE_DOMAINS[$i]}" == "$input" ]]; then
      printf '%s' "$i"
      return 0
    fi
    if [[ "${RULE_TYPES[$i]}" == "wildcard" && "$input" == *".${RULE_DOMAINS[$i]}" ]]; then
      printf '%s' "$i"
      return 0
    fi
  done

  return 1
}

hosts_for_rule() {
  local index="$1"
  local domain="${RULE_DOMAINS[$index]}"
  local type="${RULE_TYPES[$index]}"
  if [[ "$type" == "wildcard" ]]; then
    printf '%s\n' "lucky.$domain" "random-check.$domain" "$domain"
  else
    printf '%s\n' "$domain"
  fi
}

print_rules_compact() {
  load_rules
  printf '%s当前规则%s\n' "$C_BOLD" "$C_RESET"
  if [[ "${#RULE_FILES[@]}" -eq 0 ]]; then
    printf '  %s暂无规则。%s\n' "$C_DIM" "$C_RESET"
    return 0
  fi

  local i type_label domain upstream
  printf '  %s%-4s %-8s %-30s %s%s\n' "$C_DIM" "编号" "类型" "域名" "上游" "$C_RESET"
  for i in "${!RULE_FILES[@]}"; do
    if [[ "${RULE_TYPES[$i]}" == "wildcard" ]]; then
      type_label="泛域名"
      domain="*.${RULE_DOMAINS[$i]}"
    else
      type_label="固定"
      domain="${RULE_DOMAINS[$i]}"
    fi
    upstream="${RULE_UPSTREAMS[$i]}"
    printf '  %s%2d%s   %-8s %-30s %s\n' "$C_CYAN" "$((i + 1))" "$C_RESET" "$type_label" "$domain" "$upstream"
  done
}

interactive_add_rule() {
  need_root
  echo
  echo "添加反向代理规则"
  echo "  1) 泛域名：*.你的域名 和 你的域名 都转发到同一个上游"
  echo "  2) 固定域名：某个完整域名转发到一个上游"
  echo
  local type domain upstream summary
  read -rp "请选择规则类型 [1/2]：" type
  case "$type" in
    1)
      domain="$(prompt_default "域名，不要带 *")"
      upstream="$(prompt_default "上游地址")"
      summary="[泛域名] *.$domain, $domain -> $upstream"
      echo
      echo "准备添加：$summary"
      confirm "确认添加吗？" || { echo "已取消。"; return 0; }
      add_wildcard "$domain" "$upstream"
      ;;
    2)
      domain="$(prompt_default "域名")"
      upstream="$(prompt_default "上游地址")"
      summary="[固定域名] $domain -> $upstream"
      echo
      echo "准备添加：$summary"
      confirm "确认添加吗？" || { echo "已取消。"; return 0; }
      add_fixed "$domain" "$upstream"
      ;;
    *)
      echo "已取消。"
      return 0
      ;;
  esac
  if confirm "现在应用并重载 Caddy 吗？"; then
    apply_config
  fi
}

interactive_set_token() {
  need_root
  echo
  print_rules_numbered
  echo
  echo "可输入泛域名规则序号，或直接输入要设置 token 的根域名。"
  local input index domain
  read -rp "请输入序号或域名，直接回车取消：" input
  [[ -n "$input" ]] || { echo "已取消。"; return 0; }

  if index="$(resolve_rule_input "$input" 2>/dev/null)" && [[ "${RULE_TYPES[$index]}" == "wildcard" ]]; then
    domain="${RULE_DOMAINS[$index]}"
  else
    domain="$(sanitize_domain "$input")"
    domain="${domain#*.}"
  fi

  save_token "$domain"
}

interactive_remove_rule() {
  need_root
  echo
  print_rules_numbered
  echo
  if [[ "${#RULE_FILES[@]}" -eq 0 ]]; then
    return 0
  fi

  local input index domain label
  read -rp "输入要删除的序号或域名，直接回车取消：" input
  [[ -n "$input" ]] || { echo "已取消。"; return 0; }

  if ! index="$(resolve_rule_input "$input")"; then
    echo "没找到对应规则：$input"
    return 0
  fi

  domain="${RULE_DOMAINS[$index]}"
  label="$(rule_label "$index")"
  echo "将删除：$label"
  if confirm "确定删除吗？"; then
    remove_rule "$domain"
    if confirm "现在应用并重载 Caddy 吗？"; then
      apply_config
    fi
  fi
}

interactive_test_domains() {
  need_root
  echo
  print_rules_numbered
  echo
  if [[ "${#RULE_FILES[@]}" -eq 0 ]]; then
    echo "暂无规则可测试。"
    return 0
  fi

  echo "可输入："
  echo "  - 直接回车或 all：测试全部规则"
  echo "  - 序号：测试某条规则，例如 1"
  echo "  - 多个序号：测试多条规则，例如 1 2"
  echo "  - 域名：测试指定域名"
  echo "  - 多个域名：用空格分隔"
  echo
  local input index token hosts=()
  read -rp "请输入测试目标：" input

  if [[ -z "$input" || "$input" == "all" || "$input" == "ALL" ]]; then
    test_hosts
    return 0
  fi

  for token in $input; do
    if index="$(resolve_rule_input "$token" 2>/dev/null)"; then
      while IFS= read -r host; do
        hosts+=("$host")
      done < <(hosts_for_rule "$index")
    else
      hosts+=("$token")
    fi
  done

  test_hosts "${hosts[@]}"
}

interactive_bootstrap() {
  need_root
  echo
  echo "一条龙安装会安装 Caddy、安装 Cloudflare DNS 插件，"
  echo "确认基础目录、校验当前规则，并重载 Caddy。"
  echo
  if confirm "继续执行一条龙安装吗？"; then
    install_caddy
    ensure_default_config
    apply_config
  fi
}

interactive_menu() {
  need_root
  ensure_default_config
  while true; do
    clear 2>/dev/null || true
    color_setup
    ui_title "$APP_TITLE (Caddy Assistant)"
    printf '%s规则目录：%s%s%s\n' "$C_DIM" "$C_RESET" "$RULES_DIR" "$C_RESET"
    printf '%s真实配置：%s%s%s\n' "$C_DIM" "$C_RESET" "$CADDYFILE" "$C_RESET"
    ui_rule
    print_rules_compact

    ui_section "初始化与配置"
    ui_menu_row 1 "一条龙安装/初始化  *" 2 "设置 Cloudflare token"
    ui_menu_row 3 "应用配置并重载 Caddy" 4 "检查/更新 ca 自身"

    ui_section "反向代理规则"
    ui_menu_row 11 "添加反向代理规则  >" 12 "删除规则"
    ui_menu_row 13 "列出规则文件" 14 "查看规则与生成预览  >"

    ui_section "验证与真实配置"
    ui_menu_row 21 "测试域名访问" 22 "查看服务状态"
    ui_menu_row 23 "一键查看真实 Caddyfile  *" 24 "查看 Caddy 日志"

    echo
    ui_border "="
    ui_menu_row 0 "退出"
    ui_border "="
    local choice lines
    ui_prompt
    read -r choice
    case "$choice" in
      1) interactive_bootstrap; pause ;;
      2) interactive_set_token; pause ;;
      3) apply_config; pause ;;
      4) interactive_update_ca; pause ;;
      11) interactive_add_rule; pause ;;
      12) interactive_remove_rule; pause ;;
      13) ensure_default_config; find "$RULES_DIR" -maxdepth 1 -type f -print | sort; pause ;;
      14) show_rules | sed -n '1,220p'; pause ;;
      21) interactive_test_domains; pause ;;
      22) status; pause ;;
      23) show_caddyfile; pause ;;
      24)
        lines="$(prompt_default "日志行数" "80")"
        logs "$lines"
        pause
        ;;
      0|q|Q|exit) break ;;
      *) echo "未知选项。"; pause ;;
    esac
  done
}

bootstrap() {
  need_root
  while [[ $# -gt 0 ]]; do
    case "$1" in
      *)
        die "未知 bootstrap 参数：$1"
        ;;
    esac
  done
  install_caddy
  ensure_default_config
  apply_config
  status
}

main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    install) install_caddy ;;
    bootstrap) bootstrap "$@" ;;
    token)
      case "${1:-}" in
        set) shift; save_token "${1:-}" "${2:-}" ;;
        check) shift; check_token "${1:-}" ;;
        *) usage; exit 1 ;;
      esac
      ;;
    apply) apply_config ;;
    show) show_rules ;;
    caddyfile|cat-caddyfile|real-caddyfile) show_caddyfile ;;
    status) status ;;
    test) test_hosts "$@" ;;
    logs) logs "${1:-80}" ;;
    update) update_ca ;;
    add-wildcard) [[ $# -eq 2 ]] || die "用法：ca add-wildcard DOMAIN UPSTREAM"; add_wildcard "$1" "$2" ;;
    add-fixed) [[ $# -eq 2 ]] || die "用法：ca add-fixed DOMAIN UPSTREAM"; add_fixed "$1" "$2" ;;
    remove) [[ $# -eq 1 ]] || die "用法：ca remove DOMAIN"; remove_rule "$1" ;;
    list) ensure_default_config; find "$RULES_DIR" -maxdepth 1 -type f -print | sort ;;
    menu) interactive_menu ;;
    "" ) interactive_menu ;;
    -h|--help|help) usage ;;
    *) usage; exit 1 ;;
  esac
}

main "$@"
